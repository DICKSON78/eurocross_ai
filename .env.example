APP_NAME="EuroCross AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_API_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eurocross_ai
DB_USERNAME=eurocross_ai
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers. Set at least one real provider key in production.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_COST_PER_MILLION_CHARACTERS=25.00
OPENAI_COST_PER_MILLION_TOKENS=

# Payment provider: gumroad, lemon_squeezy, or stripe
PAYMENT_PROVIDER=gumroad

# Gumroad. Keep access token and webhook secret out of source control.
GUMROAD_ACCESS_TOKEN=
GUMROAD_WEBHOOK_SECRET=
GUMROAD_SELLER_ID=
GUMROAD_TRIAL_DAYS=7
GUMROAD_PRODUCT_STARTER=
GUMROAD_PRODUCT_GROWTH=
GUMROAD_PRODUCT_SCALE=
GUMROAD_PRODUCT_ID_STARTER=
GUMROAD_PRODUCT_ID_GROWTH=
GUMROAD_PRODUCT_ID_SCALE=
GUMROAD_CHECKOUT_STARTER=https://augustinodickson.gumroad.com/l/eurocross-starter
GUMROAD_CHECKOUT_GROWTH=https://augustinodickson.gumroad.com/l/eurocross-growth
GUMROAD_CHECKOUT_SCALE=https://augustinodickson.gumroad.com/l/eurocross-scale

# Optional providers; unused while PAYMENT_PROVIDER=gumroad.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_STARTER=
LEMON_SQUEEZY_VARIANT_GROWTH=
LEMON_SQUEEZY_VARIANT_SCALE=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Google Socialite fallback. Native One Tap stays disabled until this is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Firebase web config. These values are public browser config, not server secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# GeoIP/VAT support.
GEOIP_URL=https://ipapi.co/{ip}/json/
GEOIP_DEFAULT_COUNTRY=TZ
